{
  "name": "@multiplayer-agent-sdk/mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing grounded, read-only guidance about the Multiplayer Agent SDK's adapter interface to coding agents (Claude Code, Cursor, etc).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "multiplayer-agent-sdk-mcp": "dist/index.js"
  },
  "files": ["dist"],
  "author": "nlehnhof",
  "homepage": "https://github.com/nlehnhof/multiplayer-sdk/tree/master/packages/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nlehnhof/multiplayer-sdk.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/nlehnhof/multiplayer-sdk/issues"
  },
  "keywords": ["mcp", "model-context-protocol", "multiplayer", "ai-agent", "claude-code", "cursor"],
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@multiplayer-agent-sdk/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2"
  }
}
